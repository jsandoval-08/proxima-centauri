---
import mision from '../data/mision.json';
import { filas, errorPromedio, formato, rango } from '../lib/calculos.js';

const lista = filas(mision);
const prom = errorPromedio(lista);
const alt = mision.real.altimetro;
const reales = mision.real.puntos_vuelo ?? [];
const curva = mision.prediccion.curva;

// Gráfica altura vs. tiempo
const W = 640, H = 440, m = { l: 62, r: 20, t: 20, b: 56 };
const tMax = Math.ceil(Math.max(...curva.puntos.map((p) => p[0]), ...reales.map((p) => p[0])) / 5) * 5;
const hMax = Math.ceil(Math.max(...curva.puntos.map((p) => p[1]), ...reales.map((p) => p[1])) / 10) * 10 + 10;
const x = (t) => m.l + (t / tMax) * (W - m.l - m.r);
const y = (h) => H - m.b - (h / hMax) * (H - m.t - m.b);
const d = curva.puntos.map((p, i) => `${i ? 'L' : 'M'}${x(p[0]).toFixed(1)} ${y(p[1]).toFixed(1)}`).join(' ');
const xs = Array.from({ length: tMax / 5 + 1 }, (_, i) => i * 5);
const ys = Array.from({ length: hMax / 10 + 1 }, (_, i) => i * 10);
const apo = mision.prediccion.apogeo.central;

// Escala del indicador: 0–20 % de error
const ESC = 20;
const pos = prom.valor === null ? null : Math.min(prom.valor, ESC) / ESC * 100;
---
<section class="seccion" id="resultados" aria-labelledby="t-res">
  <div class="contenedor">
    <div class="seccion__cab reveal">
      <p class="etiqueta" style="margin:0">05 / Resultados</p>
      <h2 class="titulo" id="t-res">PREDICCIÓN <span style="color:var(--cian-centauri)">VS. REAL</span></h2>
    </div>

    <div class="res">
      <div class="prec hud reveal">
        <div>
          <p class="etiqueta" style="margin:0 0 10px">Error promedio global</p>
          {prom.valor === null
            ? <p class="prec__n pend" style="margin:0">PENDIENTE DE LANZAMIENTO</p>
            : <p class="prec__n" style="margin:0">{formato(prom.valor, 1)}<small>%</small></p>}
          <p class="nota" style="margin:10px 0 0">
            {prom.valor === null
              ? 'Se calcula al registrar los datos reales.'
              : `Promedio de ${prom.n} de ${lista.length} variables. Menor es mejor.`}
          </p>
        </div>
        <div aria-hidden="true">
          <div class="escala">
            {[0, 5, 10, 15, 20].map((v) => (
              <><span class="g" style={`left:${v / ESC * 100}%`}></span><b style={`left:${v / ESC * 100}%`}>{v}%</b></>
            ))}
            {[2.5, 7.5, 12.5, 17.5].map((v) => <span style={`left:${v / ESC * 100}%`}></span>)}
            {pos !== null && <i style={`left:${pos}%`}></i>}
          </div>
        </div>
      </div>

      <div class="tabla-w hud reveal">
        <table class="tabla">
          <caption class="etiqueta">Tabla comparativa · error % = |predicho − real| / real × 100</caption>
          <thead>
            <tr>
              <th scope="col">Variable</th>
              <th scope="col">Predicción</th>
              <th scope="col">Real</th>
              <th scope="col">Error abs.</th>
              <th scope="col">Error %</th>
            </tr>
          </thead>
          <tbody>
            {lista.map((f) => (
              <tr>
                <th scope="row">{f.nombre}</th>
                <td data-l="Predicción">
                  <span>{formato(f.pred.central, f.decimales)}<span class="u">{f.unidad}</span>{f.pred.estimado && <span class="est">ESTIMADO</span>}
                    {f.pred.min !== f.pred.max && <span class="rg">rango {rango(f.pred, f.decimales)}</span>}</span>
                </td>
                <td data-l="Real"><span>{f.real === null ? <span class="pend-t">Pendiente</span> : <>{formato(f.real, f.decimales)}<span class="u">{f.unidad}</span></>}</span></td>
                <td data-l="Error abs."><span>{f.errAbs === null ? '—' : <>{formato(f.errAbs, f.decimales)}<span class="u">{f.unidad}</span></>}</span></td>
                <td data-l="Error %"><span>{f.errPct === null ? '—' : <>{formato(f.errPct, 1)}<span class="u">%</span></>}</span></td>
              </tr>
            ))}
            <tr>
              <th scope="row">Estado del altímetro</th>
              <td data-l="Predicción"><span><span class="alt">Intacto</span></span></td>
              <td data-l="Real"><span>{alt === null
                ? <span class="pend-t">Pendiente</span>
                : <span class={`alt ${alt === 'intacto' ? '' : 'alt--bad'}`}>{alt === 'intacto' ? 'Intacto' : 'Dañado'}</span>}</span></td>
              <td data-l="Error abs."><span>—</span></td>
              <td data-l="Error %"><span>—</span></td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="graf hud reveal" id="grafica">
        <div class="graf__cab">
          <span class="etiqueta" style="margin:0">Altura vs. tiempo</span>
          <span class="leyenda"><i></i>Curva predicha{curva.estimado ? ' (estimada)' : ''}</span>
          <span class="leyenda"><i class="p"></i>Datos reales</span>
          <span class="leyenda"><i class="v"></i>Apogeo previsto {formato(apo, 0)} m</span>
        </div>
        <div class="graf__lienzo">
          <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="g-t g-d">
            <title id="g-t">Gráfica de altura contra tiempo</title>
            <desc id="g-d">Curva predicha con apogeo de {apo} metros{reales.length ? ' y puntos medidos del vuelo real.' : '. Aún no hay datos reales del vuelo.'}</desc>
            {xs.map((t) => <line class="g-rej" x1={x(t)} y1={m.t} x2={x(t)} y2={H - m.b} />)}
            {ys.map((h) => <line class="g-rej" x1={m.l} y1={y(h)} x2={W - m.r} y2={y(h)} />)}
            <line class="g-eje" x1={m.l} y1={m.t} x2={m.l} y2={H - m.b} />
            <line class="g-eje" x1={m.l} y1={H - m.b} x2={W - m.r} y2={H - m.b} />
            {xs.map((t) => <text class="g-txt" x={x(t)} y={H - m.b + 24} text-anchor="middle">{t}</text>)}
            {ys.map((h) => <text class="g-txt" x={m.l - 10} y={y(h) + 5} text-anchor="end">{h}</text>)}
            <text class="g-txt" x={W - m.r} y={H - 8} text-anchor="end">t (s)</text>
            <text class="g-txt" x={m.l + 8} y={m.t + 14}>h (m)</text>
            <line class="g-apo" x1={m.l} y1={y(apo)} x2={W - m.r} y2={y(apo)} />
            <path class="g-curva" pathLength="1" d={d} />
            {reales.map((p) => (
              <g>
                <circle class="g-pulso" cx={x(p[0])} cy={y(p[1])} r="9" />
                <circle class="g-pt" cx={x(p[0])} cy={y(p[1])} r="5" />
              </g>
            ))}
          </svg>
          {reales.length === 0 && <div class="graf__pend">Pendiente de lanzamiento</div>}
        </div>
        <p class="nota" style="margin:0">
          {curva.estimado ? 'La curva predicha es una estimación preliminar y se reemplazará con la salida del modelo final. ' : ''}Los motores Estes varían cerca de ±{mision.prediccion.tolerancia_motor_pct} % entre piezas.
        </p>
      </div>
    </div>
  </div>
</section>
