---
const enlaces = [
  ['#mision', 'Misión'],
  ['#cohete', 'Cohete'],
  ['#modelo', 'Modelo'],
  ['#resultados', 'Resultados'],
  ['#bitacora', 'Bitácora'],
  ['#equipo', 'Equipo'],
];
---
<header class="header">
  <div class="contenedor header__in">
    <a class="marca" href="#inicio" aria-label="Próxima Centauri, inicio">
      <img src={`${import.meta.env.BASE_URL}logo-proxima-centauri.svg`} alt="" width="38" height="44" />
      <span>PRÓXIMA <b>CENTAURI</b></span>
    </a>
    <nav class="nav" aria-label="Principal">
      {enlaces.map(([h, t]) => <a href={h}>{t}</a>)}
    </nav>
    <details class="menu">
      <summary>Menú</summary>
      <nav aria-label="Principal (móvil)">
        {enlaces.map(([h, t]) => <a href={h}>{t}</a>)}
      </nav>
    </details>
    <div class="sys" aria-hidden="true"><i></i>SYS · OK</div>
  </div>
</header>
<script>
  // Cierra el menú móvil al elegir una sección.
  document.querySelectorAll('.menu a').forEach((a) =>
    a.addEventListener('click', () => a.closest('details')?.removeAttribute('open'))
  );
</script>
